{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reqoo-catalog-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reqoo-rebuild",
      "database_id": "15123ddd-d63a-4033-9123-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "reqoo-product-media"
    }
  ]
}
