{
  "name": "reqoo-3d-studio",
  "version": "1.4.0",
  "private": true,
  "description": "Offline 3D lettering and relief editor",
  "author": "Reqoo",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "desktop": "electron .",
    "package": "electron-builder --win zip --x64",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "installer": "powershell -NoProfile -File desktop/build-installer.ps1"
  },
  "devDependencies": {
    "@tabler/icons": "^3.35.0",
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "jsqr": "1.4.0",
    "manifold-3d": "3.5.4",
    "playwright": "1.56.1",
    "qrcode-generator": "2.0.4",
    "three": "0.170.0",
    "vite": "6.4.1"
  },
  "build": {
    "appId": "co.reqoo.studio3d",
    "productName": "Reqoo 3D Studio",
    "directories": {
      "output": "release/1.4.0"
    },
    "files": [
      "dist/**/*",
      "desktop/*.cjs",
      "desktop/fonts/**/*",
      "desktop/*LICENSE*.txt",
      "desktop/THIRD-PARTY-NOTICES.txt",
      "desktop/PANDUAN-v1.4.0.txt",
      "desktop/RUJUKAN-RASMI-v1.0.0.md",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Reqoo-3D-Studio-${version}-Setup-x64.exe"
    },
    "artifactName": "Reqoo-3D-Studio-${version}-Portable-x64.${ext}",
    "extraFiles": [
      {
        "from": "desktop/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "desktop/FONT-LICENSES.txt",
        "to": "FONT-LICENSES.txt"
      },
      {
        "from": "desktop/PANDUAN-v1.4.0.txt",
        "to": "PANDUAN-v1.4.0.txt"
      },
      {
        "from": "desktop/RUJUKAN-RASMI-v1.0.0.md",
        "to": "RUJUKAN-RASMI.md"
      }
    ]
  },
  "overrides": {
    "temp": "0.9.4",
    "fflate": "0.8.3"
  }
}
