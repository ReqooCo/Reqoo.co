{"bankId":"B-SRC-14-0913","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"ratio_difference_total","plannedLevel":3,"question":"Nisbah murid Kumpulan A kepada Kumpulan B ialah 7:4. Jika Kumpulan A mempunyai 12 murid lebih ramai daripada Kumpulan B, berapakah jumlah murid kedua-dua kumpulan?","options":["33","40","44","48"],"answerIndex":2,"solutionSteps":["Perbezaan nisbah = 7 − 4 = 3 bahagian = 12 murid.","1 bahagian = 4 murid.","Jumlah = (7 + 4) × 4 = 44 murid."]}
