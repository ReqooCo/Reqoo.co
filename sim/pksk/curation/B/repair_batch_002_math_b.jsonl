{"bankId":"B-SRC-18-1192","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"order_operations_inventory","plannedLevel":2,"question":"Sebuah kedai menerima 6 kotak, setiap satu mengandungi 24 tin. Sebanyak 35 tin dijual pada pagi hari dan 28 tin pada petang hari. Berapa tin masih ada?","options":["71","79","81","109"],"answerIndex":2,"solutionSteps":["Jumlah awal = 6 × 24 = 144.","Jumlah dijual = 35 + 28 = 63.","Baki = 144 − 63 = 81."]}
