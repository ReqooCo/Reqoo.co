{"bankId":"B-SRC-15-0988","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"floor_tiles_decimal_side","plannedLevel":3,"question":"Lantai berukuran 4 m × 3 m hendak ditutup dengan jubin segi empat sama bersisi 0.5 m tanpa ruang. Berapakah jubin diperlukan?","options":["24","48","36","60"],"answerIndex":1,"solutionSteps":["Luas lantai = 4 × 3 = 12 m².","Luas satu jubin = 0.5 × 0.5 = 0.25 m².","12 ÷ 0.25 = 48 jubin."]}
{"bankId":"B-SRC-15-0989","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"volume_cm3_to_litre","plannedLevel":3,"question":"Sebuah bekas berukuran 25 cm × 20 cm × 10 cm. Jika penuh, berapakah kapasitinya dalam liter?","options":["0.5 L","50 L","5 L","500 L"],"answerIndex":2,"solutionSteps":["Isi padu = 25 × 20 × 10 = 5000 cm³.","1000 cm³ = 1 L, jadi 5000 cm³ = 5 L."]}
{"bankId":"B-SRC-15-0990","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"constant_rate_distance","plannedLevel":3,"question":"Seorang penunggang bergerak 18 km dalam 1.5 jam pada kadar tetap. Jika dia bergerak selama 2.25 jam pada kadar yang sama, berapakah jarak yang dilalui?","options":["24 km","30 km","40.5 km","27 km"],"answerIndex":3,"solutionSteps":["Kadar = 18 ÷ 1.5 = 12 km/j.","Jarak = 12 × 2.25 = 27 km."]}
{"bankId":"B-SRC-15-0991","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"percent_discount_change","plannedLevel":3,"question":"Harga sebuah beg ialah RM85. Kedai memberi diskaun 20%. Jika pembeli membayar dengan RM100, berapakah baki wang?","options":["RM32","RM15","RM17","RM68"],"answerIndex":0,"solutionSteps":["Diskaun = 20% × 85 = RM17.","Harga selepas diskaun = 85 - 17 = RM68.","Baki = 100 - 68 = RM32."]}
{"bankId":"B-SRC-15-0992","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"mean_replace_value","plannedLevel":3,"question":"Purata lima nombor ialah 64. Jika satu nombor bernilai 50 diganti dengan 70, berapakah purata baharu?","options":["66","68","70","72"],"answerIndex":1,"solutionSteps":["Jumlah asal = 64 × 5 = 320.","Jumlah baharu = 320 - 50 + 70 = 340.","Purata baharu = 340 ÷ 5 = 68."]}
{"bankId":"B-SRC-15-0993","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"right_triangle_missing_angle","plannedLevel":2,"question":"Sebuah segi tiga bersudut tegak mempunyai satu lagi sudut 37°. Berapakah sudut ketiga?","options":["37°","43°","53°","63°"],"answerIndex":2,"solutionSteps":["Jumlah sudut segi tiga = 180°.","Sudut ketiga = 180° - 90° - 37° = 53°."]}
{"bankId":"B-SRC-15-0994","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"map_scale_total_route","plannedLevel":3,"question":"Pada peta, 1 cm mewakili 4 m. Satu laluan terdiri daripada dua segmen berukuran 7.5 cm dan 2.5 cm pada peta. Berapakah panjang sebenar seluruh laluan?","options":["30 m","35 m","50 m","40 m"],"answerIndex":3,"solutionSteps":["Jumlah panjang pada peta = 7.5 + 2.5 = 10 cm.","Panjang sebenar = 10 × 4 = 40 m."]}
{"bankId":"B-SRC-16-1056","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"weighted_mean_books","plannedLevel":4,"question":"Dalam satu kumpulan, 2 murid membaca 2 buku setiap seorang, 3 murid membaca 3 buku setiap seorang dan 5 murid membaca 4 buku setiap seorang. Berapakah purata bilangan buku dibaca bagi seorang murid?","options":["3.3","3.0","3.5","4.0"],"answerIndex":0,"solutionSteps":["Jumlah buku = (2×2) + (3×3) + (5×4) = 4 + 9 + 20 = 33.","Jumlah murid = 2 + 3 + 5 = 10.","Purata = 33 ÷ 10 = 3.3."]}
{"bankId":"B-SRC-16-1057","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"same_perimeter_square_rectangle_width","plannedLevel":3,"question":"Sebuah segi empat sama bersisi 11 cm mempunyai perimeter yang sama dengan sebuah segi empat tepat yang panjangnya 15 cm. Berapakah lebar segi empat tepat itu?","options":["6 cm","7 cm","8 cm","14 cm"],"answerIndex":1,"solutionSteps":["Perimeter segi empat sama = 4 × 11 = 44 cm.","Bagi segi empat tepat, panjang + lebar = 44 ÷ 2 = 22 cm.","Lebar = 22 - 15 = 7 cm."]}
{"bankId":"B-SRC-16-1058","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"rectangular_frame_area","plannedLevel":3,"question":"Sebuah bingkai luar berukuran 18 cm × 14 cm. Ruang kosong di tengah berukuran 16 cm × 12 cm. Berapakah luas bingkai sahaja?","options":["32 cm²","192 cm²","60 cm²","252 cm²"],"answerIndex":2,"solutionSteps":["Luas luar = 18 × 14 = 252 cm².","Luas ruang tengah = 16 × 12 = 192 cm².","Luas bingkai = 252 - 192 = 60 cm²."]}
{"bankId":"B-SRC-16-1059","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"cuboid_count_cubes","plannedLevel":3,"question":"Sebuah kuboid berukuran 9 cm × 6 cm × 3 cm diisi penuh dengan kubus bersisi 3 cm. Berapakah bilangan kubus yang diperlukan?","options":["3","9","18","6"],"answerIndex":3,"solutionSteps":["Isi padu kuboid = 9 × 6 × 3 = 162 cm³.","Isi padu satu kubus = 3³ = 27 cm³.","162 ÷ 27 = 6."]}
{"bankId":"B-SRC-16-1060","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"elapsed_time_midnight","plannedLevel":3,"question":"Sebuah aktiviti bermula pada 10:45 malam dan tamat pada 12:20 tengah malam. Berapa lamakah aktiviti itu?","options":["1 jam 35 minit","1 jam 25 minit","1 jam 45 minit","2 jam 35 minit"],"answerIndex":0,"solutionSteps":["10:45 malam hingga 12:00 = 1 jam 15 minit.","12:00 hingga 12:20 = 20 minit.","Jumlah = 1 jam 35 minit."]}
{"bankId":"B-SRC-16-1061","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"ratio_total_difference","plannedLevel":2,"question":"Wang RM125 dibahagi antara Amir dan Bakar dalam nisbah 2:3. Berapakah beza wang yang diterima mereka?","options":["RM20","RM25","RM50","RM75"],"answerIndex":1,"solutionSteps":["Jumlah bahagian = 5, jadi 1 bahagian = RM125 ÷ 5 = RM25.","Beza nisbah ialah 1 bahagian, jadi beza wang = RM25."]}
{"bankId":"B-SRC-16-1062","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"mean_missing_day","plannedLevel":3,"question":"Purata bilangan pelanggan bagi lima hari ialah 24. Bilangan bagi empat hari ialah 18, 22, 25 dan 27. Berapakah bilangan pelanggan pada hari kelima?","options":["24","26","28","30"],"answerIndex":2,"solutionSteps":["Jumlah lima hari = 24 × 5 = 120.","Jumlah empat hari = 18 + 22 + 25 + 27 = 92.","Hari kelima = 120 - 92 = 28."]}
{"bankId":"B-SRC-16-1063","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"quadrilateral_missing_angle","plannedLevel":2,"question":"Tiga sudut sebuah segi empat ialah 90°, 85° dan 110°. Berapakah sudut keempat?","options":["65°","85°","95°","75°"],"answerIndex":3,"solutionSteps":["Jumlah sudut segi empat = 360°.","90 + 85 + 110 = 285°.","Sudut keempat = 360 - 285 = 75°."]}
{"bankId":"B-SRC-16-1064","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"reflection_vertical_line","plannedLevel":4,"question":"Titik A berada pada (2,7). Titik itu dicerminkan pada garis menegak x = 5. Apakah koordinat imej A?","options":["(8,7)","(3,7)","(5,7)","(8,5)"],"answerIndex":0,"solutionSteps":["Jarak titik A daripada garis x=5 ialah 3 unit ke kiri.","Imej berada 3 unit ke kanan garis itu: x = 5 + 3 = 8.","Nilai y kekal 7, jadi imej ialah (8,7)."]}
{"bankId":"B-SRC-17-1126","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"combined_group_mean","plannedLevel":4,"question":"Kumpulan A mempunyai 4 murid dengan purata markah 70. Kumpulan B mempunyai 6 murid dengan purata 80. Berapakah purata markah semua 10 murid?","options":["74","76","75","78"],"answerIndex":1,"solutionSteps":["Jumlah markah A = 4 × 70 = 280.","Jumlah markah B = 6 × 80 = 480.","Jumlah = 760; 760 ÷ 10 = 76."]}
{"bankId":"B-SRC-17-1127","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"fraction_complement_sum","plannedLevel":2,"question":"Pada waktu pagi, 3/8 daripada bekalan digunakan. Pada petang, 1/4 daripada jumlah asal digunakan. Apakah pecahan bekalan yang masih tinggal?","options":["1/4","1/2","3/8","5/8"],"answerIndex":2,"solutionSteps":["1/4 = 2/8.","Jumlah digunakan = 3/8 + 2/8 = 5/8.","Baki = 8/8 - 5/8 = 3/8."]}
{"bankId":"B-SRC-17-1128","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"percent_two_categories_remainder","plannedLevel":3,"question":"Daripada 240 pelekat, 35% berwarna merah dan 1/4 daripada jumlah keseluruhan berwarna biru. Selebihnya hijau. Berapakah pelekat hijau?","options":["84","100","156","96"],"answerIndex":3,"solutionSteps":["Merah = 35% × 240 = 84.","Biru = 1/4 × 240 = 60.","Hijau = 240 - 84 - 60 = 96."]}
{"bankId":"B-SRC-17-1129","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"mixed_length_subtraction","plannedLevel":3,"question":"Seutas tali panjangnya 2.4 m. Sebanyak 75 cm dan 0.85 m dipotong. Berapakah baki tali dalam meter?","options":["0.80 m","0.55 m","1.20 m","1.60 m"],"answerIndex":0,"solutionSteps":["75 cm = 0.75 m.","Jumlah dipotong = 0.75 + 0.85 = 1.60 m.","Baki = 2.40 - 1.60 = 0.80 m."]}
{"bankId":"B-SRC-17-1130","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"decimal_mass_multi_step","plannedLevel":3,"question":"Enam beg tepung masing-masing berjisim 1.25 kg. Sebanyak 2.3 kg tepung digunakan. Berapakah jisim tepung yang masih ada?","options":["4.5 kg","5.2 kg","5.0 kg","7.5 kg"],"answerIndex":1,"solutionSteps":["Jumlah tepung = 6 × 1.25 = 7.5 kg.","Baki = 7.5 - 2.3 = 5.2 kg."]}
