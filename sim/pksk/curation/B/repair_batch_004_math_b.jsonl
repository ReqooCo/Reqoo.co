{"bankId":"B-SRC-17-1132","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"fraction_of_remainder_twostep","plannedLevel":3,"question":"Sebuah album mempunyai 60 pelekat. Sebanyak 1/5 daripadanya diberikan kepada rakan. Kemudian 1/4 daripada baki dijual. Berapakah pelekat yang tinggal?","options":["30","38","48","36"],"answerIndex":3,"solutionSteps":["Diberi = 1/5 × 60 = 12; baki = 48.","Dijual = 1/4 × 48 = 12.","Baki akhir = 48 - 12 = 36."]}
