{"bankId":"B-SRC-37-2529","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"cuboid_volume_to_equal_bottles","plannedLevel":3,"question":"Sebuah bekas mengandungi 3600 cm³ air. Air itu dituangkan sama rata ke dalam botol 450 mL. Berapakah botol penuh yang dapat diisi?","options":["6 botol","7 botol","8 botol","9 botol"],"answerIndex":2,"solutionSteps":["3600 cm³ = 3600 mL.","3600 ÷ 450 = 8.","Jadi 8 botol penuh dapat diisi."]}
