{"bankId":"B-SRC-28-1895","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"ratio_total_from_difference","plannedLevel":4,"question":"Nisbah bilangan A kepada B ialah 7:4. Beza bilangan A dan B ialah 24. Berapakah jumlah A dan B?","options":["72","88","80","96"],"answerIndex":1,"solutionSteps":["Beza nisbah = 7 − 4 = 3 bahagian, bersamaan 24.","1 bahagian = 24 ÷ 3 = 8; jumlah bahagian = 11.","Jumlah A dan B = 11 × 8 = 88."]}
