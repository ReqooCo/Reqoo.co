{"bankId":"B-SRC-28-1892","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"unlike_fraction_subtraction","plannedLevel":3,"question":"Berapakah hasil 5/6 − 3/8 dalam bentuk termudah?","options":["7/24","13/24","17/24","11/24"],"answerIndex":3,"solutionSteps":["KPK bagi 6 dan 8 ialah 24, jadi 5/6 = 20/24 dan 3/8 = 9/24.","20/24 − 9/24 = 11/24."]}
