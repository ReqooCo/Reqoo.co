{"bankId":"B-SRC-33-2251","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0011","constructFamily":"money_profit_total_units","plannedLevel":3,"question":"Seorang murid membeli 12 pen pada harga RM1.80 setiap satu dan menjual semuanya pada RM2.50 setiap satu. Berapakah jumlah untung?","options":["RM7.20","RM8.00","RM8.40","RM9.60"],"answerIndex":2,"solutionSteps":["Untung sebatang = RM2.50 − RM1.80 = RM0.70.","Jumlah untung = 12 × RM0.70 = RM8.40."]}
