{"bankId":"B-SRC-33-2246","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"weighted_mean_equal_groups","plannedLevel":3,"question":"Dua kumpulan masing-masing mempunyai 5 murid. Purata markah Kumpulan A ialah 68 dan Kumpulan B ialah 76. Berapakah purata markah kesemua 10 murid?","options":["70","72","73","74"],"answerIndex":1,"solutionSteps":["Jumlah markah A = 68 × 5 = 340 dan B = 76 × 5 = 380.","Jumlah = 720.","Purata 10 murid = 720 ÷ 10 = 72."]}
{"bankId":"B-SRC-33-2247","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"perimeter_square_after_side_increase","plannedLevel":3,"question":"Sebuah segi empat sama mempunyai sisi 9 cm. Setiap sisi dipanjangkan 3 cm. Berapakah pertambahan perimeter?","options":["9 cm","24 cm","12 cm","36 cm"],"answerIndex":2,"solutionSteps":["Pertambahan bagi setiap sisi = 3 cm.","Terdapat 4 sisi, jadi pertambahan perimeter = 4 × 3 = 12 cm."]}
{"bankId":"B-SRC-33-2248","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"area_two_nonoverlap_rectangles","plannedLevel":3,"question":"Rajah menunjukkan dua kawasan segi empat tepat yang tidak bertindih, masing-masing 12 cm × 5 cm dan 8 cm × 4 cm. Berapakah jumlah luas kedua-duanya?","options":["80 cm²","88 cm²","96 cm²","92 cm²"],"answerIndex":3,"solutionSteps":["Luas pertama = 12 × 5 = 60 cm².","Luas kedua = 8 × 4 = 32 cm².","Jumlah = 60 + 32 = 92 cm²."]}
{"bankId":"B-SRC-33-2249","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"volume_number_of_small_cubes","plannedLevel":3,"question":"Sebuah kotak berukuran 12 cm × 9 cm × 6 cm diisi dengan kubus kecil bersisi 3 cm. Berapakah bilangan kubus kecil yang memenuhi kotak itu?","options":["24","18","27","36"],"answerIndex":0,"solutionSteps":["Bilangan sepanjang dimensi ialah 12÷3=4, 9÷3=3 dan 6÷3=2.","Jumlah kubus = 4 × 3 × 2 = 24."]}
