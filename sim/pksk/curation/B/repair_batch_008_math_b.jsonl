{"bankId":"B-SRC-34-2311","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"division_with_remainder_interpretation","plannedLevel":4,"question":"Sebanyak 985 mL jus hendak dituangkan ke dalam cawan berkapasiti 120 mL. Berapakah bilangan cawan yang boleh diisi penuh dan baki jus?","options":["7 cawan, baki 145 mL","8 cawan, baki 35 mL","8 cawan, baki 25 mL","9 cawan, baki 5 mL"],"answerIndex":2,"solutionSteps":["120 × 8 = 960 mL.","985 − 960 = 25 mL.","Jadi 8 cawan penuh dan baki 25 mL."]}
