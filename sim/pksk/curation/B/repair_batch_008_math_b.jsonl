{"bankId":"B-SRC-33-2253","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"triangle_missing_angle_after_equal_pair","plannedLevel":3,"question":"Sebuah segi tiga mempunyai dua sudut yang sama besar. Sudut ketiga ialah 44°. Berapakah setiap sudut yang sama besar itu?","options":["68°","62°","72°","78°"],"answerIndex":0,"solutionSteps":["Jumlah dua sudut sama = 180° − 44° = 136°.","Setiap satu = 136° ÷ 2 = 68°."]}
