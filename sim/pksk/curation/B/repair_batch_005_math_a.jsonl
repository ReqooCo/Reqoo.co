{"bankId":"B-SRC-19-1267","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"rectangle_ratio_dimensions_from_perimeter","plannedLevel":4,"question":"Panjang sebuah segi empat tepat ialah tiga kali lebarnya. Perimeternya 64 cm. Berapakah luas segi empat tepat itu?","options":["128 cm²","160 cm²","192 cm²","256 cm²"],"answerIndex":2,"solutionSteps":["Panjang + lebar = 64 ÷ 2 = 32.","Jika lebar = w, panjang = 3w; maka 4w = 32 dan w = 8 cm.","Panjang = 24 cm, jadi luas = 24 × 8 = 192 cm²."]}
