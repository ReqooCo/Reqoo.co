{"bankId":"B-SRC-20-1341","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"profit_percent_of_cost","plannedLevel":3,"question":"Sebuah barang dibeli pada harga RM80 dan dijual pada harga RM100. Berapakah peratus untung berdasarkan harga kos?","options":["20%","80%","125%","25%"],"answerIndex":3,"solutionSteps":["Untung = RM100 − RM80 = RM20.","Peratus untung = 20 ÷ 80 × 100% = 25%."]}
