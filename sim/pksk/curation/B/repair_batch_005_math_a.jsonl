{"bankId":"B-SRC-20-1338","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"equal_area_square_rectangle_missing_length","plannedLevel":3,"question":"Sebuah segi empat sama bersisi 12 cm mempunyai luas yang sama dengan sebuah segi empat tepat yang lebarnya 9 cm. Berapakah panjang segi empat tepat itu?","options":["16 cm","12 cm","18 cm","20 cm"],"answerIndex":0,"solutionSteps":["Luas segi empat sama = 12 × 12 = 144 cm².","Panjang × 9 = 144.","Panjang = 16 cm."]}
{"bankId":"B-SRC-20-1339","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"combined_full_and_half_cuboid_volume","plannedLevel":3,"question":"Bekas A berukuran 12 cm × 10 cm × 5 cm dan penuh dengan air. Bekas B berukuran 10 cm × 8 cm × 5 cm dan separuh penuh. Berapakah jumlah isi padu air dalam kedua-dua bekas?","options":["600 cm³","800 cm³","700 cm³","1000 cm³"],"answerIndex":1,"solutionSteps":["A: 12 × 10 × 5 = 600 cm³.","B penuh = 400 cm³, jadi separuh = 200 cm³.","Jumlah = 600 + 200 = 800 cm³."]}
