{"bankId":"B-SRC-19-1270","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"elapsed_time_across_midnight","plannedLevel":2,"question":"Sebuah perjalanan bermula pada 11:35 malam dan tamat pada 1:20 pagi keesokan harinya. Berapakah tempoh perjalanan?","options":["1 jam 15 minit","1 jam 45 minit","1 jam 55 minit","2 jam 15 minit"],"answerIndex":1,"solutionSteps":["11:35 malam hingga 12:00 tengah malam = 25 minit.","12:00 hingga 1:20 pagi = 1 jam 20 minit.","Jumlah = 1 jam 45 minit."]}
{"bankId":"B-SRC-19-1271","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"fraction_then_percent_budget_balance","plannedLevel":4,"question":"Aina mempunyai RM50. Dia menggunakan 3/5 daripada wang itu untuk buku. Kemudian dia menggunakan 25% daripada baki untuk alat tulis. Berapakah wang yang masih tinggal?","options":["RM10","RM20","RM15","RM25"],"answerIndex":2,"solutionSteps":["Belanja buku = 3/5 × RM50 = RM30; baki RM20.","Belanja alat tulis = 25% × RM20 = RM5.","Baki akhir = RM20 − RM5 = RM15."]}
{"bankId":"B-SRC-19-1272","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"range_after_data_correction","plannedLevel":3,"question":"Rajah data menunjukkan 12, 18, 20, 25 dan 15. Kemudian bacaan 25 didapati tersalah catat dan dibetulkan kepada 17. Apakah julat data selepas pembetulan?","options":["5","10","13","8"],"answerIndex":3,"solutionSteps":["Data baharu ialah 12, 18, 20, 17 dan 15.","Nilai maksimum = 20 dan minimum = 12.","Julat = 20 − 12 = 8."],"visual":{"kind":"five_value_data","values":[12,18,20,25,15]}}
{"bankId":"B-SRC-19-1273","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"triangle_angle_ratio_largest","plannedLevel":3,"question":"Tiga sudut sebuah segi tiga mempunyai nisbah 2:3:4. Berapakah sudut yang paling besar?","options":["80°","60°","70°","90°"],"answerIndex":0,"solutionSteps":["Jumlah bahagian = 2 + 3 + 4 = 9.","Satu bahagian = 180° ÷ 9 = 20°.","Sudut terbesar = 4 × 20° = 80°."]}
{"bankId":"B-SRC-19-1274","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"coordinate_right_angle_path_length","plannedLevel":2,"question":"Pada grid, A=(2,3), B=(2,9) dan C=(8,9). Jika bergerak dari A ke B kemudian ke C mengikut garis lurus grid, berapakah jumlah jaraknya?","options":["6 unit","12 unit","9 unit","14 unit"],"answerIndex":1,"solutionSteps":["A ke B = 9 − 3 = 6 unit.","B ke C = 8 − 2 = 6 unit.","Jumlah jarak = 12 unit."]}
