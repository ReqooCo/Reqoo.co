{"bankId":"B-SRC-13-0853","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"straight_angle_ratio","plannedLevel":3,"question":"Dua sudut bersebelahan pada satu garis lurus mempunyai nisbah 2:3. Berapakah sudut yang lebih besar?","options":["72°","90°","108°","120°"],"answerIndex":2,"solutionSteps":["Jumlah sudut pada garis lurus = 180°.","Jumlah bahagian = 2 + 3 = 5, jadi 1 bahagian = 36°.","Sudut lebih besar = 3 × 36° = 108°."]}
{"bankId":"B-SRC-13-0854","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"coordinate_translation_xy","plannedLevel":2,"question":"Titik P berada pada (7,2). Titik itu digerakkan 5 unit ke kiri dan 4 unit ke atas. Apakah koordinat baharu P?","options":["(2,-2)","(3,6)","(12,6)","(2,6)"],"answerIndex":3,"solutionSteps":["x: 7 - 5 = 2.","y: 2 + 4 = 6.","Koordinat baharu ialah (2,6)."]}
{"bankId":"B-SRC-14-0917","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"notch_perimeter","plannedLevel":4,"question":"Sebuah kad berbentuk segi empat tepat 12 cm × 9 cm mempunyai lekuk segi empat tepat sedalam 3 cm dipotong dari tengah salah satu sisi 12 cm. Lebar lekuk itu 4 cm. Berapakah perimeter kad selepas dipotong?","options":["48 cm","42 cm","46 cm","50 cm"],"answerIndex":0,"solutionSteps":["Perimeter asal = 2(12 + 9) = 42 cm.","Potongan lekuk menggantikan 4 cm sisi asal dengan 4 cm bahagian dalam, jadi perubahan hanya datang daripada dua sisi sedalam 3 cm.","Perimeter baharu = 42 + 3 + 3 = 48 cm."]}
{"bankId":"B-SRC-14-0918","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"area_room_minus_rug","plannedLevel":2,"question":"Lantai bilik berukuran 6 m × 5 m. Sebuah permaidani 2 m × 3 m menutupi sebahagian lantai. Berapakah luas lantai yang tidak ditutupi?","options":["18 m²","24 m²","26 m²","30 m²"],"answerIndex":1,"solutionSteps":["Luas lantai = 6 × 5 = 30 m².","Luas permaidani = 2 × 3 = 6 m².","Tidak ditutupi = 30 - 6 = 24 m²."]}
{"bankId":"B-SRC-14-0919","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"half_cuboid_plus_volume","plannedLevel":3,"question":"Sebuah bekas kuboid berukuran 20 cm × 10 cm × 6 cm diisi air sehingga separuh penuh. Kemudian 300 cm³ air ditambah. Berapakah isi padu air sekarang?","options":["600 cm³","750 cm³","900 cm³","1 200 cm³"],"answerIndex":2,"solutionSteps":["Isi padu bekas = 20 × 10 × 6 = 1200 cm³.","Separuh penuh = 600 cm³.","600 + 300 = 900 cm³."]}
{"bankId":"B-SRC-14-0920","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"journey_two_legs_break","plannedLevel":3,"question":"Sebuah bas bertolak pada 8:20 pagi. Perjalanan pertama mengambil 55 minit, berhenti 20 minit, kemudian perjalanan kedua mengambil 35 minit. Pada pukul berapakah bas tiba?","options":["9:50 pagi","10:00 pagi","10:20 pagi","10:10 pagi"],"answerIndex":3,"solutionSteps":["8:20 + 55 minit = 9:15.","Tambah rehat 20 minit = 9:35.","Tambah 35 minit = 10:10 pagi."]}
{"bankId":"B-SRC-14-0921","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"unit_price_savings","plannedLevel":3,"question":"Enam botol air dijual dalam satu pek pada harga RM15.00. Jika dibeli satu-satu, setiap botol berharga RM2.80. Berapakah penjimatan membeli satu pek?","options":["RM1.80","RM0.80","RM1.20","RM2.80"],"answerIndex":0,"solutionSteps":["Harga enam botol satu-satu = 6 × RM2.80 = RM16.80.","Penjimatan = RM16.80 - RM15.00 = RM1.80."]}
{"bankId":"B-SRC-14-0922","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"target_average_next_score","plannedLevel":3,"question":"Purata empat ujian seorang murid ialah 75. Berapakah markah ujian kelima yang diperlukan supaya purata lima ujian menjadi 78?","options":["78","90","85","93"],"answerIndex":1,"solutionSteps":["Jumlah empat ujian = 75 × 4 = 300.","Jumlah diperlukan untuk purata 78 = 78 × 5 = 390.","Markah kelima = 390 - 300 = 90."]}
{"bankId":"B-SRC-14-0923","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"angles_around_point","plannedLevel":2,"question":"Tiga daripada empat sudut di sekeliling satu titik ialah 95°, 110° dan 65°. Berapakah sudut keempat?","options":["80°","85°","90°","100°"],"answerIndex":2,"solutionSteps":["Jumlah sudut di sekeliling satu titik = 360°.","95 + 110 + 65 = 270°.","Sudut keempat = 360 - 270 = 90°."]}
{"bankId":"B-SRC-14-0924","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"missing_rectangle_vertex","plannedLevel":2,"question":"Tiga bucu sebuah segi empat tepat ialah A(2,2), B(8,2) dan C(8,6). Apakah koordinat bucu D yang melengkapkan segi empat tepat itu?","options":["(6,2)","(6,8)","(8,8)","(2,6)"],"answerIndex":3,"solutionSteps":["A dan B berkongsi y=2; B dan C berkongsi x=8.","Bucu D perlu berkongsi x=2 dengan A dan y=6 dengan C.","D = (2,6)."]}
{"bankId":"B-SRC-15-0987","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"square_perimeter_from_area","plannedLevel":2,"question":"Luas sebuah segi empat sama ialah 144 cm². Berapakah perimeternya?","options":["48 cm","36 cm","72 cm","576 cm"],"answerIndex":0,"solutionSteps":["Sisi segi empat sama = √144 = 12 cm.","Perimeter = 4 × 12 = 48 cm."]}
