{"bankId":"B-SRC-36-2460","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0010","constructFamily":"duration_24_hour_format","plannedLevel":3,"question":"Satu aktiviti bermula pada 13:45 dan tamat pada 16:20. Berapakah tempohnya?","options":["2 jam 25 minit","2 jam 45 minit","2 jam 35 minit","3 jam 35 minit"],"answerIndex":2,"solutionSteps":["13:45 hingga 15:45 = 2 jam.","15:45 hingga 16:20 = 35 minit.","Jumlah = 2 jam 35 minit."]}
{"bankId":"B-SRC-36-2461","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0011","constructFamily":"compare_discount_vs_fixed_rebate","plannedLevel":3,"question":"Sebuah barang berharga RM120. Pilihan A memberi diskaun 15%, manakala Pilihan B memberi rebat RM20. Pilihan manakah lebih menjimatkan dan berapa beza penjimatan?","options":["Pilihan A, lebih jimat RM2","Pilihan A, lebih jimat RM5","Pilihan B, lebih jimat RM5","Pilihan B, lebih jimat RM2"],"answerIndex":3,"solutionSteps":["Diskaun 15% × RM120 = RM18.","Rebat Pilihan B = RM20.","Pilihan B lebih jimat RM20 − RM18 = RM2."]}
