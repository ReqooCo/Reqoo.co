{"bankId":"B-SRC-37-2522","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"fraction_of_remainder_two_stage","plannedLevel":3,"question":"Sebuah kotak mempunyai 80 biskut. 1/4 daripadanya dimakan. Kemudian 1/3 daripada baki diberikan kepada rakan. Berapakah biskut yang tinggal?","options":["40","20","45","60"],"answerIndex":0,"solutionSteps":["Selepas 1/4 dimakan: 80 − 20 = 60.","1/3 daripada 60 = 20 diberikan.","Baki = 60 − 20 = 40."],"visual":{"kind":"fraction_bar","parts":4,"selected":1}}
