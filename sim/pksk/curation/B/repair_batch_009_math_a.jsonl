{"bankId":"B-SRC-36-2457","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"l_shape_perimeter_from_notch","plannedLevel":3,"question":"Sebuah kad segi empat tepat 14 cm × 10 cm dipotong satu lekuk segi empat tepat sedalam 2 cm dari tengah salah satu sisi. Berapakah pertambahan perimeter akibat lekuk itu?","options":["2 cm","6 cm","8 cm","4 cm"],"answerIndex":3,"solutionSteps":["Lebar lekuk yang dibuang pada sisi asal diganti oleh lebar yang sama pada bahagian dalam.","Pertambahan perimeter hanya daripada dua sisi sedalam 2 cm.","Pertambahan = 2 + 2 = 4 cm."]}
