{"bankId":"B-MATH-NEW-0176","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"coordinate_quadrant_sign_identification","plannedLevel":2,"question":"Titik manakah berada di sebelah kiri paksi-y dan di atas paksi-x?","options":["(3,4)","(−3,4)","(−3,−4)","(4,−3)"],"answerIndex":1,"solutionSteps":["Sebelah kiri paksi-y bermaksud koordinat x negatif.","Di atas paksi-x bermaksud y positif, jadi (−3,4)."]}
{"bankId":"B-MATH-NEW-0177","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"coordinate_move_then_vertical_distance","plannedLevel":3,"question":"Titik R=(1,2) bergerak 5 unit ke kanan, kemudian 4 unit ke atas. Berapakah jarak menegak titik akhir daripada paksi-x?","options":["4 unit","5 unit","6 unit","9 unit"],"answerIndex":2,"solutionSteps":["Selepas bergerak ke kanan, nilai y kekal 2. Kemudian naik 4 unit, y menjadi 6.","Jarak menegak daripada paksi-x ialah |6| = 6 unit."]}
{"bankId":"B-MATH-NEW-0178","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"straight_angle_remaining_then_halved","plannedLevel":3,"question":"Rajah menunjukkan sudut 106° pada satu garis lurus. Sudut bersebelahan dibahagi sama rata kepada dua bahagian. Berapakah setiap bahagian?","options":["32°","42°","53°","37°"],"answerIndex":3,"solutionSteps":["Sudut bersebelahan = 180°−106° = 74°.","Setiap bahagian = 74°÷2 = 37°."],"visual":{"kind":"straight_line_angle","known_angle_deg":106}}
{"bankId":"B-MATH-NEW-0179","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"turn_sequence_final_compass_direction","plannedLevel":4,"question":"Sebuah robot mula menghadap timur. Ia berpusing 90° ke kiri, 180° ke kanan, kemudian 90° ke kiri. Ke arah manakah robot akhirnya menghadap?","options":["Timur","Utara","Selatan","Barat"],"answerIndex":0,"solutionSteps":["Putaran bersih = −90° + 180° −90° = 0° jika kanan positif.","Robot kembali ke arah asal, iaitu timur."]}
{"bankId":"B-MATH-NEW-0180","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"probability_number_multiple_property","plannedLevel":2,"question":"Sepuluh kad bernombor 1 hingga 10 dimasukkan ke dalam sebuah kotak. Satu kad dipilih secara rawak. Apakah kebarangkalian memilih nombor yang merupakan gandaan 3?","options":["1/5","3/10","2/5","1/2"],"answerIndex":1,"solutionSteps":["Gandaan 3 antara 1 hingga 10 ialah 3, 6 dan 9, iaitu 3 kad.","Kebarangkalian = 3 daripada 10 = 3/10."]}
{"bankId":"B-MATH-NEW-0181","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"probability_at_least_one_success_two_trials","plannedLevel":4,"question":"Sebuah syiling adil dilambung dua kali. Apakah kebarangkalian mendapat sekurang-kurangnya satu gambar?","options":["1/4","1/2","3/4","2/3"],"answerIndex":2,"solutionSteps":["Empat hasil sama kemungkinan ialah AA, AG, GA, GG, dengan G mewakili gambar.","Tiga daripada empat hasil mempunyai sekurang-kurangnya satu gambar, jadi kebarangkalian = 3/4."]}
{"bankId":"B-MATH-NEW-0182","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"increasing_difference_pattern_next","plannedLevel":3,"question":"Urutan nombor ialah 4, 7, 12, 19, 28, ... Apakah nombor seterusnya?","options":["37","40","41","39"],"answerIndex":3,"solutionSteps":["Beza ialah +3, +5, +7, +9.","Beza seterusnya +11, jadi 28+11 = 39."]}
{"bankId":"B-MATH-NEW-0183","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"alternating_multiply_add_pattern","plannedLevel":4,"question":"Urutan nombor ialah 2, 6, 8, 24, 26, 78, ... Apakah nombor seterusnya?","options":["80","79","82","234"],"answerIndex":0,"solutionSteps":["Pola berulang ialah ×3, kemudian +2.","Selepas 78, gunakan +2, jadi 80."]}
{"bankId":"B-MATH-NEW-0184","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"algebra_two_item_prices","plannedLevel":3,"question":"Dua buku dan tiga pen berharga RM27. Jika satu buku berharga RM6, berapakah harga satu pen?","options":["RM4","RM5","RM6","RM7"],"answerIndex":1,"solutionSteps":["Kos dua buku = 2×RM6 = RM12; baki untuk tiga pen = RM27−RM12 = RM15.","Harga satu pen = RM15÷3 = RM5."]}
{"bankId":"B-MATH-NEW-0185","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"age_difference_future_sum","plannedLevel":4,"question":"Umur Ali 4 tahun lebih tua daripada Bakar. Lima tahun lagi, jumlah umur mereka ialah 40 tahun. Berapakah umur Bakar sekarang?","options":["11 tahun","15 tahun","13 tahun","17 tahun"],"answerIndex":2,"solutionSteps":["Jika umur Bakar=x, Ali=x+4. Lima tahun lagi: (x+5)+(x+9)=40.","2x+14=40, jadi x=13 tahun."]}
{"bankId":"B-MATH-NEW-0186","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"mass_conversion_subtraction","plannedLevel":2,"question":"Sebuah bungkusan berjisim 3.2 kg. Selepas 750 g dikeluarkan, berapakah jisim yang tinggal dalam gram?","options":["2350 g","2500 g","2550 g","2450 g"],"answerIndex":3,"solutionSteps":["3.2 kg = 3200 g.","3200−750 = 2450 g."]}
{"bankId":"B-MATH-NEW-0187","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"capacity_sum_mixed_units","plannedLevel":3,"question":"Tiga bekas mengandungi 1.5 L, 850 mL dan 2.25 L. Berapakah jumlah isi padu semuanya dalam liter?","options":["4.6 L","4.1 L","4.55 L","5.1 L"],"answerIndex":0,"solutionSteps":["850 mL = 0.85 L.","Jumlah = 1.5+0.85+2.25 = 4.60 L."]}
{"bankId":"B-MATH-NEW-0188","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"scale_drawing_area_conversion","plannedLevel":4,"question":"Rajah pelan menunjukkan bilik 4 cm × 3 cm pada skala 1 cm : 2 m. Berapakah luas sebenar bilik?","options":["24 m²","48 m²","36 m²","96 m²"],"answerIndex":1,"solutionSteps":["Ukuran sebenar = 8 m × 6 m.","Luas sebenar = 8×6 = 48 m²."],"visual":{"kind":"rectangle","length_cm":4,"width_cm":3}}
{"bankId":"B-MATH-NEW-0189","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"percentage_score_gain_points_to_percent","plannedLevel":3,"question":"Markah seorang murid meningkat daripada 60 kepada 72 daripada jumlah maksimum 80. Peningkatan 12 markah itu bersamaan berapa peratus daripada markah maksimum?","options":["12%","18%","15%","20%"],"answerIndex":2,"solutionSteps":["Peningkatan = 72−60 = 12 markah.","12/80×100% = 15%."]}
{"bankId":"B-MATH-NEW-0190","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"ratio_with_percentage_subgroup","plannedLevel":4,"question":"Nisbah murid lelaki kepada perempuan ialah 2:3 dalam kelas 40 orang. Jika 25% murid lelaki memakai cermin mata, berapa murid lelaki tidak memakai cermin mata?","options":["8","10","16","12"],"answerIndex":3,"solutionSteps":["Lelaki = 2/5×40 = 16 orang.","25%×16 = 4 memakai cermin mata; tidak memakai = 16−4 = 12."]}
{"bankId":"B-MATH-NEW-0191","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"fraction_bar_equivalent_decimal","plannedLevel":2,"question":"Rajah menunjukkan 3 daripada 8 bahagian yang sama berlorek. Apakah nilai perpuluhan bagi bahagian berlorek?","options":["0.375","0.35","0.38","0.625"],"answerIndex":0,"solutionSteps":["Bahagian berlorek = 3/8.","3÷8 = 0.375."],"visual":{"kind":"fraction_bar","parts":8,"selected":3}}
{"bankId":"B-MATH-NEW-0192","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"decimal_unit_price_total","plannedLevel":3,"question":"Sebanyak 2.5 kg buah berharga RM6.40 bagi setiap kilogram. Berapakah jumlah harga?","options":["RM14.40","RM16.00","RM15.00","RM16.40"],"answerIndex":1,"solutionSteps":["Jumlah harga = 2.5×RM6.40.","= RM16.00."]}
{"bankId":"B-MATH-NEW-0193","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"cuboid_partial_fill_then_add","plannedLevel":4,"question":"Rajah menunjukkan bekas 20 cm × 15 cm × 12 cm. Bekas itu pada mulanya separuh penuh air. Kemudian 900 cm³ air ditambah. Berapakah isi padu air sekarang?","options":["1800 cm³","2400 cm³","2700 cm³","3600 cm³"],"answerIndex":2,"solutionSteps":["Kapasiti penuh = 20×15×12 = 3600 cm³; separuh = 1800 cm³.","Selepas tambah 900 cm³, jumlah = 2700 cm³."],"visual":{"kind":"cuboid","length_cm":20,"width_cm":15,"height_cm":12}}
{"bankId":"B-MATH-NEW-0194","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"mean_after_adding_known_value","plannedLevel":3,"question":"Rajah data menunjukkan 10, 12, 14, 16 dan 18. Jika nilai 20 ditambah, berapakah min baharu?","options":["14","16","17","15"],"answerIndex":3,"solutionSteps":["Jumlah asal = 70; selepas tambah 20, jumlah = 90.","Min baharu = 90÷6 = 15."],"visual":{"kind":"five_value_data","values":[10,12,14,16,18]}}
{"bankId":"B-MATH-NEW-0195","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"square_multiple_rounds_border_length","plannedLevel":2,"question":"Rajah menunjukkan sebuah petak dengan sisi 9 cm. Reben hendak mengelilingi petak itu sebanyak 3 pusingan. Berapakah panjang reben diperlukan?","options":["108 cm","36 cm","81 cm","117 cm"],"answerIndex":0,"solutionSteps":["Perimeter satu pusingan = 4×9 = 36 cm.","Tiga pusingan = 3×36 = 108 cm."],"visual":{"kind":"rectangle","length_cm":9,"width_cm":9}}
{"bankId":"B-MATH-NEW-0196","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"sessions_with_fixed_break_total_duration","plannedLevel":3,"question":"Tiga sesi masing-masing mengambil 35 minit. Terdapat rehat 10 minit antara sesi pertama-kedua dan kedua-ketiga. Berapakah jumlah masa dari mula hingga tamat?","options":["1 jam 55 minit","2 jam 5 minit","2 jam 15 minit","2 jam 25 minit"],"answerIndex":1,"solutionSteps":["Masa sesi = 3×35 = 105 minit; rehat = 2×10 = 20 minit.","Jumlah = 125 minit = 2 jam 5 minit."]}
{"bankId":"B-MATH-NEW-0197","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"best_value_membership_fee_break_even","plannedLevel":4,"question":"Pelan A mengenakan RM8 setiap lawatan tanpa yuran. Pelan B mengenakan yuran RM20 dan RM4 setiap lawatan. Pada berapa lawatan jumlah kos kedua-dua pelan sama?","options":["4 lawatan","6 lawatan","5 lawatan","8 lawatan"],"answerIndex":2,"solutionSteps":["Kos A = 8n; kos B = 20+4n.","8n=20+4n, jadi 4n=20 dan n=5."]}
{"bankId":"B-MATH-NEW-0198","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"decimal_temperature_difference","plannedLevel":2,"question":"Suhu dua tempat ialah 18.5°C dan 23.8°C. Berapakah beza suhu kedua-duanya?","options":["4.3°C","5.8°C","6.3°C","5.3°C"],"answerIndex":3,"solutionSteps":["Beza suhu = 23.8−18.5.","= 5.3°C."]}
{"bankId":"B-MATH-NEW-0199","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"rounding_sum_three_numbers","plannedLevel":3,"question":"Bundarkan 148, 263 dan 391 kepada ratus terdekat, kemudian cari jumlah anggaran.","options":["800","700","900","1000"],"answerIndex":0,"solutionSteps":["148→100, 263→300 dan 391→400.","Jumlah anggaran = 100+300+400 = 800."]}
{"bankId":"B-MATH-NEW-0200","section":"BAHAGIAN B","domain":"Matematik","authoringType":"NEW_AUTHOR_DEFICIT","reviewStatus":"EDITORIAL_NEW_PENDING_QA","constructFamily":"budget_discount_and_delivery","plannedLevel":3,"question":"Sebuah barang berharga RM250 mendapat diskaun 12%. Selepas itu caj penghantaran RM18 ditambah. Berapakah jumlah bayaran akhir?","options":["RM220","RM238","RM232","RM248"],"answerIndex":1,"solutionSteps":["Harga selepas diskaun = RM250×0.88 = RM220.","Tambah penghantaran RM18: jumlah = RM238."]}
