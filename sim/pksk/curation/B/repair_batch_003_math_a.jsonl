{"bankId":"B-SRC-46-3153","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"mode_tie_after_add","plannedLevel":3,"question":"Data 4, 7, 7, 9, 10, 10, 10, 12 mempunyai mod 10. Jika satu lagi nombor 7 ditambah, apakah mod baharu?","options":["7 sahaja","10 sahaja","7 dan 10","Tiada mod"],"answerIndex":2,"solutionSteps":["Selepas tambah 7: nilai 7 muncul 3 kali dan 10 muncul 3 kali.","Kedua-duanya menjadi mod."]}
{"bankId":"B-SRC-47-3223","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"range_invariant_shift","plannedLevel":3,"question":"Lima bacaan ialah 14, 18, 22, 26 dan 30. Jika setiap bacaan ditambah 3, apakah julat data baharu?","options":["12","16","19","22"],"answerIndex":1,"solutionSteps":["Menambah nilai sama kepada semua data tidak mengubah julat.","Julat asal = 30 − 14 = 16."]}
