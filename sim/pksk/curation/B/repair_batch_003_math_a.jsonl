{"bankId":"B-SRC-23-1543","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"decimal_capacity_two_step","plannedLevel":2,"question":"Sebuah tong mengandungi 12.5 L air. Sebanyak 3.75 L digunakan, kemudian 2.4 L ditambah semula. Berapakah isi padu air sekarang?","options":["10.15 L","11.15 L","11.25 L","14.65 L"],"answerIndex":1,"solutionSteps":["12.5 − 3.75 = 8.75 L.","8.75 + 2.4 = 11.15 L."]}
{"bankId":"B-SRC-24-1613","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"decimal_equal_share_remaining","plannedLevel":3,"question":"Sebanyak 9.6 kg tepung dibahagikan sama rata ke dalam 8 bekas. Dua bekas telah digunakan. Berapakah jisim tepung yang masih belum digunakan?","options":["2.4 kg","7.2 kg","8.4 kg","9.6 kg"],"answerIndex":1,"solutionSteps":["Setiap bekas = 9.6 ÷ 8 = 1.2 kg.","Dua bekas digunakan = 2.4 kg.","Baki = 9.6 − 2.4 = 7.2 kg."]}
{"bankId":"B-SRC-25-1683","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"mixed_unit_repeated_cut","plannedLevel":3,"question":"Satu gulung wayar panjangnya 6.5 m. Empat bahagian masing-masing sepanjang 85 cm dipotong. Berapakah baki wayar dalam meter?","options":["2.1 m","3.1 m","3.4 m","4.1 m"],"answerIndex":1,"solutionSteps":["85 cm = 0.85 m.","Empat bahagian = 4 × 0.85 = 3.4 m.","Baki = 6.5 − 3.4 = 3.1 m."]}
{"bankId":"B-SRC-26-1753","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"triangle_missing_height","plannedLevel":3,"question":"Sebuah segi tiga mempunyai luas 54 cm² dan tapak 12 cm. Berapakah tingginya?","options":["4.5 cm","6 cm","9 cm","12 cm"],"answerIndex":2,"solutionSteps":["54 = 1/2 × 12 × tinggi.","54 = 6 × tinggi, jadi tinggi = 9 cm."]}
{"bankId":"B-SRC-27-1823","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"frame_area_difference","plannedLevel":3,"question":"Sebuah bingkai luar berukuran 20 cm × 15 cm dan ruang gambar di tengah berukuran 16 cm × 11 cm. Berapakah luas bahagian bingkai sahaja?","options":["80 cm²","124 cm²","176 cm²","300 cm²"],"answerIndex":1,"solutionSteps":["Luas luar = 20 × 15 = 300 cm².","Luas ruang gambar = 16 × 11 = 176 cm².","Luas bingkai = 300 − 176 = 124 cm²."]}
{"bankId":"B-SRC-28-1893","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"three_side_perimeter","plannedLevel":2,"question":"Sebuah kebun berbentuk segi empat tepat berukuran 24 m × 18 m. Pagar dipasang pada tiga sisi sahaja: dua sisi lebar dan satu sisi panjang. Berapakah panjang pagar diperlukan?","options":["60 m","66 m","84 m","108 m"],"answerIndex":0,"solutionSteps":["Panjang pagar = 18 + 18 + 24 = 60 m."]}
{"bankId":"B-SRC-29-1963","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"cuboid_missing_height","plannedLevel":2,"question":"Isi padu sebuah kuboid ialah 360 cm³. Panjangnya 10 cm dan lebarnya 6 cm. Berapakah tingginya?","options":["5 cm","6 cm","8 cm","10 cm"],"answerIndex":1,"solutionSteps":["Tinggi = 360 ÷ (10 × 6).","360 ÷ 60 = 6 cm."]}
{"bankId":"B-SRC-30-2033","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"cuboid_half_then_add","plannedLevel":3,"question":"Sebuah bekas kuboid berukuran 20 cm × 10 cm × 8 cm. Air memenuhi separuh bekas. Kemudian 400 cm³ air ditambah. Berapakah isi padu air sekarang?","options":["800 cm³","1 000 cm³","1 200 cm³","1 600 cm³"],"answerIndex":2,"solutionSteps":["Isi padu bekas = 20 × 10 × 8 = 1600 cm³.","Separuh = 800 cm³.","Tambah 400 cm³ = 1200 cm³."]}
{"bankId":"B-SRC-31-2103","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"three_cubes_volume","plannedLevel":2,"question":"Sebuah kotak berbentuk kubus mempunyai sisi 4 cm. Tiga kotak yang sama diisi penuh. Berapakah jumlah isi padu ketiga-tiga kotak?","options":["64 cm³","128 cm³","192 cm³","256 cm³"],"answerIndex":2,"solutionSteps":["Isi padu satu kubus = 4 × 4 × 4 = 64 cm³.","Tiga kubus = 3 × 64 = 192 cm³."]}
{"bankId":"B-SRC-32-2173","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"three_part_ratio","plannedLevel":2,"question":"Nisbah murid yang memilih bola sepak, badminton dan catur ialah 3:2:1. Jika 36 murid terlibat, berapakah murid memilih badminton?","options":["6","12","18","24"],"answerIndex":1,"solutionSteps":["Jumlah bahagian = 3 + 2 + 1 = 6.","Setiap bahagian = 36 ÷ 6 = 6.","Badminton = 2 × 6 = 12."]}
{"bankId":"B-SRC-33-2243","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"ratio_reverse_after_change","plannedLevel":3,"question":"Nisbah pensel merah kepada pensel biru ialah 5:3. Selepas 4 pensel merah diberi kepada rakan, bilangannya menjadi 16. Berapakah bilangan pensel biru pada asalnya?","options":["8","12","16","20"],"answerIndex":1,"solutionSteps":["Pensel merah asal = 16 + 4 = 20.","5 bahagian = 20, jadi 1 bahagian = 4.","Pensel biru = 3 × 4 = 12."]}
{"bankId":"B-SRC-34-2313","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"percentage_then_subtract","plannedLevel":2,"question":"Dalam satu sekolah, 40% daripada 250 murid datang dengan bas. Daripada murid yang menaiki bas, 15 orang tidak hadir. Berapakah murid yang hadir dan menaiki bas?","options":["75","85","100","115"],"answerIndex":1,"solutionSteps":["40% × 250 = 100 murid menaiki bas.","100 − 15 = 85 murid."]}
{"bankId":"B-SRC-35-2383","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"reverse_percentage_price","plannedLevel":3,"question":"Selepas diskaun 20%, harga sebuah kasut ialah RM96. Berapakah harga asal kasut itu?","options":["RM110","RM115","RM120","RM125"],"answerIndex":2,"solutionSteps":["Harga selepas diskaun ialah 80% daripada harga asal.","RM96 ÷ 0.8 = RM120."]}
{"bankId":"B-SRC-36-2453","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"percentage_remainder_two_categories","plannedLevel":3,"question":"Dalam tinjauan 320 murid, 25% memilih membaca dan 35% memilih sukan. Selebihnya memilih aktiviti lain. Berapakah murid memilih aktiviti lain?","options":["96","112","128","192"],"answerIndex":2,"solutionSteps":["Peratus aktiviti lain = 100% − 25% − 35% = 40%.","40% × 320 = 128."]}
{"bankId":"B-SRC-37-2523","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"percent_and_fraction_of_original","plannedLevel":3,"question":"Sebuah kedai menjual 240 botol minuman. Pada pagi hari 30% terjual dan pada petang hari 1/4 daripada jumlah asal terjual. Berapakah botol yang masih ada?","options":["96","108","120","132"],"answerIndex":1,"solutionSteps":["Pagi: 30% × 240 = 72.","Petang: 1/4 × 240 = 60.","Baki = 240 − 72 − 60 = 108."]}
{"bankId":"B-SRC-38-2593","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"fraction_complement_two_days","plannedLevel":3,"question":"Aina membaca 3/10 daripada sebuah buku pada Isnin dan 1/4 pada Selasa. Apakah pecahan buku yang belum dibaca?","options":["7/20","9/20","11/20","13/20"],"answerIndex":1,"solutionSteps":["3/10 = 6/20; 1/4 = 5/20.","Jumlah dibaca = 11/20.","Belum dibaca = 20/20 − 11/20 = 9/20."]}
{"bankId":"B-SRC-39-2663","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"fraction_of_remainder","plannedLevel":3,"question":"Sebuah bekas penuh mengandungi 48 biskut. Ali mengambil 1/4 daripadanya, kemudian Siti mengambil 1/3 daripada baki. Berapakah biskut yang tinggal?","options":["20","24","28","32"],"answerIndex":1,"solutionSteps":["Ali ambil 1/4 × 48 = 12; baki 36.","Siti ambil 1/3 × 36 = 12.","Baki akhir = 24."]}
{"bankId":"B-SRC-40-2733","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"mixed_number_equal_parts","plannedLevel":3,"question":"Sebuah tali sepanjang 4 1/2 m dipotong kepada tiga bahagian sama panjang. Berapakah panjang setiap bahagian?","options":["1 1/4 m","1 1/2 m","1 3/4 m","2 1/4 m"],"answerIndex":1,"solutionSteps":["4 1/2 = 9/2.","9/2 ÷ 3 = 9/6 = 3/2 = 1 1/2 m."]}
{"bankId":"B-SRC-41-2803","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"fraction_unit_rate_scale","plannedLevel":4,"question":"Sebuah resipi menggunakan 3/5 L susu untuk 2 kek. Berapakah susu diperlukan untuk 5 kek pada kadar yang sama?","options":["1 L","1 1/5 L","1 1/2 L","2 L"],"answerIndex":2,"solutionSteps":["Susu untuk 1 kek = 3/5 ÷ 2 = 3/10 L.","Untuk 5 kek = 5 × 3/10 = 15/10 = 1 1/2 L."]}
{"bankId":"B-SRC-42-2873","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"percent_capacity_then_subtract","plannedLevel":3,"question":"Sebuah botol 1.5 L diisi sehingga 80% penuh. Kemudian 300 mL diminum. Berapakah air yang tinggal?","options":["0.6 L","0.9 L","1.0 L","1.2 L"],"answerIndex":1,"solutionSteps":["80% × 1.5 L = 1.2 L.","300 mL = 0.3 L.","Baki = 1.2 − 0.3 = 0.9 L."]}
{"bankId":"B-SRC-43-2943","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"average_after_remove_value","plannedLevel":4,"question":"Purata enam markah ialah 72. Selepas markah tertinggi 90 dikeluarkan, berapakah purata lima markah yang tinggal?","options":["66.4","68.4","70.0","72.0"],"answerIndex":1,"solutionSteps":["Jumlah enam markah = 72 × 6 = 432.","Jumlah lima markah = 432 − 90 = 342.","Purata = 342 ÷ 5 = 68.4."]}
{"bankId":"B-SRC-44-3013","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"average_after_add_value","plannedLevel":3,"question":"Purata empat nombor ialah 18. Jika satu nombor baharu 28 ditambah, berapakah purata lima nombor itu?","options":["18","19","20","22"],"answerIndex":2,"solutionSteps":["Jumlah empat nombor = 18 × 4 = 72.","Jumlah baharu = 72 + 28 = 100.","Purata = 100 ÷ 5 = 20."]}
