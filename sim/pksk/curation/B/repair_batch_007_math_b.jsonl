{"bankId":"B-SRC-29-1968","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"rectangle_plus_triangle_composite_area","plannedLevel":3,"question":"Satu bentuk gabungan terdiri daripada segi empat tepat 10 cm × 6 cm dan sebuah segi tiga bertapak 10 cm serta tinggi 4 cm tanpa pertindihan. Berapakah luas keseluruhan?","options":["60 cm²","80 cm²","70 cm²","100 cm²"],"answerIndex":1,"solutionSteps":["Luas segi empat tepat = 10 × 6 = 60 cm².","Luas segi tiga = 1/2 × 10 × 4 = 20 cm².","Jumlah luas = 80 cm²."]}
{"bankId":"B-SRC-29-1969","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"cuboid_height_from_litre_capacity","plannedLevel":4,"question":"Sebuah bekas kuboid mempunyai kapasiti 12 L dan luas tapak 40 cm × 20 cm. Berapakah tingginya?","options":["10 cm","20 cm","15 cm","30 cm"],"answerIndex":2,"solutionSteps":["12 L = 12 000 cm³.","Luas tapak = 40 × 20 = 800 cm².","Tinggi = 12 000 ÷ 800 = 15 cm."]}
{"bankId":"B-SRC-29-1970","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0010","constructFamily":"time_zone_difference_same_instant","plannedLevel":2,"question":"Pada saat yang sama, waktu di Bandar A ialah 9:20 pagi dan waktu di Bandar B ialah 1:20 petang. Berapakah perbezaan waktu antara kedua-dua bandar?","options":["3 jam","5 jam","6 jam","4 jam"],"answerIndex":3,"solutionSteps":["Dari 9:20 pagi hingga 1:20 petang ialah 4 jam.","Jadi perbezaan waktu ialah 4 jam."]}
{"bankId":"B-SRC-29-1971","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0011","constructFamily":"unit_price_best_buy_difference","plannedLevel":4,"question":"Pek A mengandungi 8 botol pada harga RM18.40. Pek B mengandungi 12 botol pada harga RM26.40. Pek manakah lebih murah bagi setiap botol, dan berapa bezanya?","options":["Pek B, lebih murah RM0.10 sebotol","Pek A, lebih murah RM0.10 sebotol","Pek A, lebih murah RM0.20 sebotol","Pek B, lebih murah RM0.20 sebotol"],"answerIndex":0,"solutionSteps":["Harga sebotol Pek A = RM18.40 ÷ 8 = RM2.30.","Harga sebotol Pek B = RM26.40 ÷ 12 = RM2.20.","Pek B lebih murah RM0.10 sebotol."]}
{"bankId":"B-SRC-29-1972","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0012","constructFamily":"pie_angle_to_percentage","plannedLevel":3,"question":"Satu sektor carta pai bersudut 126°. Berapakah peratus keseluruhan yang diwakili oleh sektor itu?","options":["30%","35%","40%","45%"],"answerIndex":1,"solutionSteps":["Bahagian sektor = 126° ÷ 360° = 0.35.","0.35 × 100% = 35%."]}
{"bankId":"B-SRC-29-1973","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"decimal_distance_equal_stages","plannedLevel":2,"question":"Jarak 45.6 km dibahagikan sama rata kepada 4 peringkat. Berapakah jarak setiap peringkat?","options":["10.4 km","12.4 km","11.4 km","15.2 km"],"answerIndex":2,"solutionSteps":["Jarak setiap peringkat = 45.6 ÷ 4.","45.6 ÷ 4 = 11.4 km."]}
{"bankId":"B-SRC-29-1974","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0013","constructFamily":"fraction_bar_simplify","plannedLevel":2,"question":"Rajah menunjukkan 6 daripada 8 bahagian sama besar berlorek. Apakah pecahan berlorek dalam bentuk termudah?","options":["2/3","5/8","7/8","3/4"],"answerIndex":3,"solutionSteps":["Pecahan berlorek = 6/8.","Bahagi pengangka dan penyebut dengan 2: 6/8 = 3/4."],"visual":{"kind":"fraction_bar","parts":8,"selected":6}}
{"bankId":"B-SRC-30-2031","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"discount_plus_delivery","plannedLevel":3,"question":"Sebuah barang berharga RM180 diberi diskaun 15%. Selepas itu caj penghantaran RM12 dikenakan. Berapakah jumlah yang perlu dibayar?","options":["RM165","RM153","RM165.60","RM192"],"answerIndex":0,"solutionSteps":["Diskaun = 15% × RM180 = RM27, jadi harga selepas diskaun = RM153.","Tambah caj penghantaran RM12: RM153 + RM12 = RM165."]}
{"bankId":"B-SRC-30-2032","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"ratio_difference_given_total","plannedLevel":3,"question":"Dua kuantiti mempunyai nisbah 5:3 dan jumlahnya 64. Berapakah perbezaan antara dua kuantiti itu?","options":["8","16","24","32"],"answerIndex":1,"solutionSteps":["Jumlah bahagian = 8, jadi satu bahagian = 64 ÷ 8 = 8.","Perbezaan = (5 − 3) × 8 = 16."]}
{"bankId":"B-SRC-30-2034","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"range_after_new_maximum","plannedLevel":2,"question":"Rajah data menunjukkan 5, 7, 7, 9 dan 12. Jika nilai 18 ditambah, berapakah julat data baharu?","options":["7","11","13","18"],"answerIndex":2,"solutionSteps":["Selepas 18 ditambah, nilai minimum kekal 5 dan nilai maksimum menjadi 18.","Julat = 18 − 5 = 13."],"visual":{"kind":"five_value_data","values":[5,7,7,9,12]}}
{"bankId":"B-SRC-30-2035","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"rectangle_area_after_inverse_scale","plannedLevel":3,"question":"Rajah menunjukkan segi empat tepat 15 cm × 8 cm. Panjangnya digandakan manakala lebarnya dibahagi dua. Berapakah luas baharu?","options":["60 cm²","180 cm²","240 cm²","120 cm²"],"answerIndex":3,"solutionSteps":["Panjang baharu = 30 cm dan lebar baharu = 4 cm.","Luas baharu = 30 × 4 = 120 cm²."],"visual":{"kind":"rectangle","length_cm":15,"width_cm":8}}
{"bankId":"B-SRC-30-2036","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"l_shape_outer_minus_void","plannedLevel":3,"question":"Rajah asas menunjukkan kawasan luar 14 cm × 10 cm. Satu ruang kosong 4 cm × 3 cm dikeluarkan untuk membentuk bentuk L. Berapakah luas bentuk L?","options":["128 cm²","118 cm²","132 cm²","140 cm²"],"answerIndex":0,"solutionSteps":["Luas kawasan luar = 14 × 10 = 140 cm².","Luas ruang kosong = 4 × 3 = 12 cm².","Luas bentuk L = 140 − 12 = 128 cm²."],"visual":{"kind":"rectangle","length_cm":14,"width_cm":10}}
{"bankId":"B-SRC-30-2037","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0007","constructFamily":"half_full_then_fraction_of_current_removed","plannedLevel":4,"question":"Rajah menunjukkan bekas kuboid 20 cm × 12 cm × 10 cm. Bekas itu separuh penuh dengan air. Kemudian 1/4 daripada air yang ada dikeluarkan. Berapakah isi padu air yang tinggal?","options":["600 cm³","900 cm³","1200 cm³","1800 cm³"],"answerIndex":1,"solutionSteps":["Kapasiti penuh = 20 × 12 × 10 = 2400 cm³; separuh penuh = 1200 cm³.","Air dikeluarkan = 1/4 × 1200 = 300 cm³.","Baki = 1200 − 300 = 900 cm³."],"visual":{"kind":"cuboid","length_cm":20,"width_cm":12,"height_cm":10}}
{"bankId":"B-SRC-30-2038","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0008","constructFamily":"equal_sessions_from_total_duration","plannedLevel":3,"question":"Sebuah latihan berlangsung 2 jam 20 minit dan dibahagikan kepada 5 sesi sama panjang tanpa rehat. Berapakah tempoh setiap sesi?","options":["24 minit","30 minit","28 minit","35 minit"],"answerIndex":2,"solutionSteps":["2 jam 20 minit = 140 minit.","140 ÷ 5 = 28 minit."]}
{"bankId":"B-SRC-30-2039","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0009","constructFamily":"budget_save_then_fraction_spend","plannedLevel":4,"question":"Daripada RM240, Aina menyimpan 25% terlebih dahulu. Kemudian dia menggunakan 1/3 daripada baki untuk pengangkutan. Berapakah wang yang masih tinggal selepas itu?","options":["RM100","RM140","RM160","RM120"],"answerIndex":3,"solutionSteps":["Simpanan = 25% × RM240 = RM60, jadi baki untuk digunakan = RM180.","Pengangkutan = 1/3 × RM180 = RM60.","Baki akhir = RM180 − RM60 = RM120."]}
{"bankId":"B-SRC-30-2040","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0010","constructFamily":"clock_face_interval_angle","plannedLevel":3,"question":"Pada muka jam, 12 nombor dibahagi sama rata mengelilingi satu bulatan. Berapakah sudut kecil dari nombor 2 ke nombor 7?","options":["150°","120°","180°","210°"],"answerIndex":0,"solutionSteps":["Sudut antara dua nombor bersebelahan = 360° ÷ 12 = 30°.","Dari nombor 2 ke nombor 7 terdapat 5 sela, jadi sudut = 5 × 30° = 150°."]}
{"bankId":"B-SRC-30-2041","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0011","constructFamily":"coordinate_vertical_distance","plannedLevel":2,"question":"Titik A=(3,8) dan B=(3,2) berada pada garis menegak yang sama. Berapakah jarak AB?","options":["5 unit","6 unit","8 unit","11 unit"],"answerIndex":1,"solutionSteps":["Koordinat-x sama, jadi hanya beza nilai y digunakan.","Jarak = 8 − 2 = 6 unit."]}
{"bankId":"B-SRC-30-2042","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0012","constructFamily":"mixed_capacity_subtraction","plannedLevel":3,"question":"Sebuah bekas mengandungi 2.5 L air. Sebanyak 650 mL digunakan, kemudian 0.75 L lagi digunakan. Berapakah air yang tinggal?","options":["0.9 L","1.25 L","1.1 L","1.85 L"],"answerIndex":2,"solutionSteps":["650 mL = 0.65 L.","Jumlah digunakan = 0.65 + 0.75 = 1.40 L.","Baki = 2.50 − 1.40 = 1.10 L."]}
{"bankId":"B-SRC-30-2043","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0001","constructFamily":"decimal_percent_fraction_equivalence","plannedLevel":3,"question":"Nilai 0.375 bersamaan 37.5%. Apakah nilai itu sebagai pecahan dalam bentuk termudah?","options":["3/10","5/8","8/3","3/8"],"answerIndex":3,"solutionSteps":["0.375 = 375/1000.","Ringkaskan dengan membahagi 125: 375/1000 = 3/8."],"visual":{"kind":"fraction_bar","parts":8,"selected":3}}
{"bankId":"B-SRC-30-2044","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0013","constructFamily":"reverse_fraction_remaining_amount","plannedLevel":3,"question":"Selepas menggunakan 2/5 daripada wangnya, Faris masih mempunyai RM72. Berapakah wang Faris pada asalnya?","options":["RM120","RM100","RM108","RM180"],"answerIndex":0,"solutionSteps":["Baki selepas menggunakan 2/5 ialah 3/5 daripada wang asal.","3/5 bersamaan RM72, jadi 1/5 = RM24.","Wang asal = 5 × RM24 = RM120."],"visual":{"kind":"fraction_bar","parts":5,"selected":3}}
{"bankId":"B-SRC-31-2101","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0002","constructFamily":"recipe_proportion_scaling","plannedLevel":3,"question":"Satu resipi untuk 4 hidangan menggunakan 300 g tepung. Pada kadar yang sama, berapakah tepung diperlukan untuk 10 hidangan?","options":["600 g","750 g","720 g","900 g"],"answerIndex":1,"solutionSteps":["Tepung untuk 1 hidangan = 300 ÷ 4 = 75 g.","Untuk 10 hidangan = 10 × 75 = 750 g."]}
{"bankId":"B-SRC-31-2102","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0003","constructFamily":"weighted_mean_frequency","plannedLevel":4,"question":"Dalam satu data, nilai 12 muncul 2 kali, nilai 18 muncul 3 kali dan nilai 24 muncul sekali. Berapakah min data itu?","options":["16","18","17","20"],"answerIndex":2,"solutionSteps":["Jumlah nilai = 12×2 + 18×3 + 24×1 = 24 + 54 + 24 = 102.","Bilangan data = 2 + 3 + 1 = 6.","Min = 102 ÷ 6 = 17."]}
{"bankId":"B-SRC-31-2104","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0004","constructFamily":"rectangle_perimeter_after_percent_dimension_changes","plannedLevel":4,"question":"Rajah menunjukkan segi empat tepat 10 cm × 6 cm. Panjangnya bertambah 20% dan lebarnya bertambah 50%. Berapakah perimeter baharu?","options":["38 cm","44 cm","48 cm","42 cm"],"answerIndex":3,"solutionSteps":["Panjang baharu = 10 × 1.20 = 12 cm; lebar baharu = 6 × 1.50 = 9 cm.","Perimeter baharu = 2(12 + 9) = 42 cm."],"visual":{"kind":"rectangle","length_cm":10,"width_cm":6}}
{"bankId":"B-SRC-31-2105","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0005","constructFamily":"time_zone_cross_previous_day","plannedLevel":3,"question":"Bandar B adalah 7 jam di belakang Bandar A. Jika waktu di Bandar A ialah 4:30 pagi, apakah waktu di Bandar B?","options":["9:30 malam, hari sebelumnya","8:30 malam, hari sebelumnya","10:30 malam, hari sebelumnya","11:30 malam, hari sebelumnya"],"answerIndex":0,"solutionSteps":["Tolak 4 jam 30 minit membawa waktu kepada 12:00 tengah malam.","Masih perlu tolak 2 jam 30 minit lagi, menjadi 9:30 malam pada hari sebelumnya."]}
{"bankId":"B-SRC-31-2106","section":"BAHAGIAN B","domain":"Matematik","repairType":"MATERIAL_REWRITE_CORE_DUPLICATE","reviewStatus":"EDITORIAL_REPAIRED_PENDING_QA","sourceDuplicateFamily":"B-CORE-DUP-0006","constructFamily":"service_charge_split_bill","plannedLevel":3,"question":"Bil makanan ialah RM84. Caj perkhidmatan 10% ditambah sebelum jumlah dibahagi sama rata antara 4 orang. Berapakah bayaran setiap orang?","options":["RM21.00","RM23.10","RM22.05","RM25.20"],"answerIndex":1,"solutionSteps":["Caj perkhidmatan = 10% × RM84 = RM8.40.","Jumlah bil = RM84 + RM8.40 = RM92.40.","Setiap orang = RM92.40 ÷ 4 = RM23.10."]}
